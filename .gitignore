# Credentials and private configuration (keep sanitized examples)
.env
.env.*
*.env
!.env.example
!.env.sample
!*.env.example
/secrets/

# Python environments, bytecode and tool caches
/.venv/
/venv/
/env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
/htmlcov/

# Build output and verification artifacts
/build/
/dist/
/output/
/.playwright-cli/
/playwright-report/
/test-results/
node_modules/

# Downloaded data, analysis results and runtime state
/data/
/eval_data/
/eval_results/
/tradingagents/dataflows/data_cache/
/.tradingagents/
/logs/
*.log
*.log.*
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Postman: keep shared definitions; exclude local state and generated files
/.postman/*
!/.postman/resources.yaml
/postman/skills/
/postman/.dependencies/
/postman/reports/
/postman/environments/*.local.*
*.postman_environment.json
*.postman_collection.json

# Editor settings, OS metadata and backup files
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.bak
*.orig
*.swp
*.swo
*~
